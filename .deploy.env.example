# Copy to .deploy.env and fill in. .deploy.env is gitignored and must stay that way.
FTP_HOST=ftp.example.com
FTP_USER=user
FTP_PASS=secret
FTP_DIR=/www/4istudio

# ftps keeps the password off the wire. Use ftp only if the host has nothing else,
# and know that the password travels in clear when you do.
FTP_PROTO=ftps
FTP_VERIFY=true
FTP_SSL_FORCE=true
